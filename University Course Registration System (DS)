void regiCourseByStu(int sid)
{
    if(currentStudent == NULL){
        printf("No student logged in\n");
        return;
    }

    int cid;
    printf("Enter Course ID: ");
    scanf("%d", &cid);

    cm *c = courseHead;

    while(c && c->id != cid)
        c = c->next;

    if(c == NULL){
        printf("Course not found\n");
        return;
    }

    if(c->enroll >= c->maxs){
        printf("Course is full\n");
        return;
    }

    rm *check = registrationHead;
    while(check){
        if(check->STUDENTID == sid && check->COURSEID == cid){
            printf("Already Registered!\n");
            return;
        }
        check = check->next;
    }

    rm *nn = (rm*)malloc(sizeof(rm));
    if(nn == NULL){
        printf("Memory allocation failed\n");
        return;
    }

    nn->STUDENTID = sid;
    nn->COURSEID = cid;
    nn->next = NULL;
    nn->prev = registrationBack;

    if(registrationBack)
        registrationBack->next = nn;
    else
        registrationHead = nn;

    registrationBack = nn;

    c->enroll++;
    saveRegistration(); 
    printf("Registration Successful.\n");
}


