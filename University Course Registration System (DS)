void managingcourse(){
    
    cm *nnode = (cm*)malloc(sizeof(cm));
    
    if(nnode == NULL){
        printf("Memory Allocation Failed\n");
        return;
    }
    
    printf("Enter Course ID: ");
    scanf("%d",&nnode->id);
    
    cm *check = courseHead;
    while(check){
        if(check->id == nnode->id){
            printf("Course ID already exists!\n");
            free(nnode);
            return;
        }
        check = check->next;
    }
    
    getchar();
    
    printf("Enter Course Name: ");
    scanf(" %[^\n]",nnode->name);
    
    printf("Enter Credits: ");
    scanf("%d",&nnode->credit);
    if(nnode->credit < 1 || nnode->credit > 6){
        printf("Invalid Credits! Must be between 1 and 6\n");
        free(nnode);
        return;
    }
    
    printf("Enter Max Students: ");
    scanf("%d",&nnode->maxs);
    if(nnode->maxs < 1 || nnode->maxs > 45){
        printf("Invalid Max Students! Must be between 1 and 45\n");
        free(nnode);
        return;
    }
    
    nnode->enroll = 0;
    nnode->prev = NULL;
    nnode->next = courseHead;
    
    if(courseHead != NULL)
        courseHead->prev = nnode;
    
    courseHead = nnode;
    
    if(courseBack == NULL)
        courseBack = nnode;

    printf("Course Added Successfully!\n");
}

