sm *findstudent(int id){
    sm *temp = studentHead;
    while(temp){
        if(temp->id==id)
        return temp;
        temp=temp->next;
    }
    return NULL;
}        
  
        
void loadstudent(){
    FILE *fp;
    fp = fopen("DSproject.txt", "r");
    if(fp == NULL){
        return;
    }
    
    int id;
    char name[30];
    float gpa;
    char password[20]; 
    
    while(fscanf(fp, "%d, %[^,], %f, %s\n", &id, name, &gpa, password) == 4){
        sm *Nnode = (sm*)malloc(sizeof(sm));
        Nnode->id = id;
        strcpy(Nnode->name, name);
        Nnode->gpa = gpa;
        strcpy(Nnode->password, password);  

        Nnode->prev = studentBack;
        Nnode->next = NULL;
        
        if(studentBack != NULL)
            studentBack->next = Nnode;
        else
            studentHead = Nnode;
        
        studentBack = Nnode;
    }
    fclose(fp);
}

void requestDrop(int sid){
    int cid;
    printf("Course ID: ");
    scanf("%d",&cid);

    dr *nn = (dr*)malloc(sizeof(dr));
    nn->sid = sid;
    nn->cid = cid;
    nn->next = dropHead;
    dropHead = nn;

    printf("Drop Request Sent!\n");
}
  
void processingDpReq(){
    dr *temp = dropHead;

    while(temp){
        dr *curr = temp;
        temp = temp->next;

        printf("\nStudent ID: %d\nCourse ID: %d\n", curr->sid, curr->cid);

        printf("1. Approve\n2. Skip\n");
        int ch;
        scanf("%d",&ch);

        if(ch == 1){
            Dropregi(curr->sid, curr->cid);
            printf("Dropped Successfully\n");
        }
        else{
            printf("Skipped\n");
        }

        if(curr == dropHead)
            dropHead = curr->next;

        free(curr);
    }
}


  void deleteStudent(int id){
      sm *temp = studentHead;
      while(temp && temp->id !=id)
      temp=temp->next;
      
      if(temp == NULL){
          printf("Student Not Found\n");
          return;
      }   
      if(temp == studentHead)
      studentHead=temp->next;
      
      if(temp == studentBack)
      studentBack=temp->prev;
      
      if(temp->prev)
      temp->prev->next = temp->next;
      
      if(temp->next)
      temp->next->prev = temp->prev;
      
      free(temp);
      }
      
