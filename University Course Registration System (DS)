   void loadRegistration(){
    FILE *fp = fopen("Registration.txt","r");

    if(fp == NULL){
        return;
    }

    int sid, cid;

    while(fscanf(fp, "%d, %d", &sid, &cid) == 2){
        rm *nn = (rm*)malloc(sizeof(rm));

        nn->STUDENTID = sid;
        nn->COURSEID = cid;

        nn->next = NULL;
        nn->prev = registrationBack;

        if(registrationBack != NULL){
            registrationBack->next = nn;
        } else {
            registrationHead = nn;
        }

        registrationBack = nn;
    }

    fclose(fp);
}
    
 void Dropregi(int sid, int cid){
    rm *temp = registrationHead;

    while(temp != NULL){
        if(temp->STUDENTID == sid && temp->COURSEID == cid)
            break;
        temp = temp->next;
    }

    if(temp == NULL){
        printf("Registration Not Found\n");
        return;
    }

    if(temp == registrationHead)
        registrationHead = temp->next;

    if(temp == registrationBack)
        registrationBack = temp->prev;

    if(temp->next != NULL)
        temp->next->prev = temp->prev;

    if(temp->prev != NULL)
        temp->prev->next = temp->next;

    cm *t = courseHead;
    while(t && t->id != cid)
        t = t->next;

    if(t != NULL && t->enroll > 0)
        t->enroll--;
     saveRegistration(); 
    free(temp);
}


