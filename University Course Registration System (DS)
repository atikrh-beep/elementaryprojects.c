   if(temp->gpa>maxgpa){
       maxgpa = temp->gpa;
       strcpy(topper, temp->name);
   }
   temp=temp->next;
 }
   printf("\n--- Student Report ---\n");

   if(count == 0){
        printf("No student data found!\n");
        return;
}

    printf("Total Students: %d\n",count);
    printf("Average Gpa: %f\n", totalgpa/count);
