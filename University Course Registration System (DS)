void managingstudent(){
    sm *Nnode = (sm*)malloc(sizeof(sm));
    if(Nnode == NULL){
        printf("Memory Allocation Failed\n");
        return;
    }
    
    printf("Enter ID: ");
    scanf("%d", &Nnode->id);
    
    if(findstudent(Nnode->id) != NULL){
        printf("Student ID already exists!\n");
        free(Nnode);
        return;
    }
    
    printf("Enter Name: ");
    getchar();  
    scanf(" %[^\n]", Nnode->name);

    printf("Enter GPA: ");
    scanf("%f", &Nnode->gpa);
    
    if(Nnode->gpa < 0.0 || Nnode->gpa > 5.0){
        printf("Invalid GPA! Must be between 0.0 and 5.0\n");
        free(Nnode);
        return;
    }
    
    printf("Set Password: ");
    scanf("%s", Nnode->password);
    
    Nnode->prev = NULL;
    Nnode->next = studentHead;
    
    if(studentHead != NULL)
        studentHead->prev = Nnode;
    
    studentHead = Nnode;

    if(studentBack == NULL)
        studentBack = Nnode;
    
   printf("Student Added Successfully!\n");
}

