}
void courseReport(){
    cm *temp = courseHead;

    int totalCourse = 0;
    int totalEnroll = 0;

    int maxEnroll = -1;
    char popularCourse[30];

    while(temp!=NULL){
        totalCourse++;
        totalEnroll = totalEnroll+temp->enroll;

    if(temp->enroll>maxEnroll){
        maxEnroll = temp->enroll;
        strcpy(popularCourse, temp->name);
    }
        temp=temp->next;
    }
    printf("\n--- Course Report ---\n");

    if(totalCourse == 0){
        printf("No course data found!\n");
        return;
    }

    printf("Total Courses: %d\n", totalCourse);
    printf("Total Enrollments: %d\n", totalEnroll);
    printf("Most Popular Course: %s (%d students)\n", popularCourse, maxEnroll);
}
 
