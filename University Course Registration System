// Structure Declaration

// STUDENT MANAGEMENT
typedef struct studentmenu{
   int id;
   char name[30];
   float gpa;
   struct studentmenu *prev;
   struct studentmenu *next;
}sm;

  sm *studentHead = NULL;
  sm *studentBack = NULL;
  time_t lastStudentview = 0;
  
typedef struct coursemenu{
    int id;
    char name[30];
    int credit;
    int maxs;
    int enroll;
    struct coursemenu *prev;
    struct coursemenu  *next;
}cm;

cm *courseHead = NULL;
cm *courseBack = NULL;
time_t lastCourseview = 0;

typedef struct resistrationmenu{
    int STUDENTID;
    int COURSEID;
    struct resistrationmenu *prev;
    struct resistrationmenu *next;
}rm;

rm *registrationHead = NULL;
rm *registrationBack = NULL;

// 1st MAIN
void managingstudent(){
    sm *Nnode = (sm*)malloc(sizeof(sm));
    if(Nnode == NULL){
        printf("Memory Allocation Failed\n");
        return ;
    }
    
    // INPUT DETAILS
    
    printf("Enter ID: ");
    scanf("%d", &Nnode->id);
    
    printf("Enter Name: ");
    getchar();  
    scanf(" %[^\n]", Nnode->name);

    printf("Enter Gpa: ");
    scanf("%f", &Nnode->gpa);
    
    Nnode->prev = NULL;
    Nnode->next = studentHead;
    
    if(studentHead != NULL){
        studentHead->prev = Nnode;
}
        studentHead = Nnode;

    if(studentBack==NULL)
        studentBack = Nnode;
}

// Id already exist
