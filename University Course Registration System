sm *findstudent(int id){
    sm *temp = studentHead;
    while(temp){
        if(temp->id==id)
        return temp;
        temp=temp->next;
    }
    return NULL;
}        
  
        
void loadstudent(){
    sm temp;
    FILE *fp;
    fp = fopen("DSproject.text", "r");
    if(fp == NULL){
        return;
    }
    
    int id;
    char name[30];
    float gpa;
    
    
    while(fscanf(fp, "%d, %[^\n], %f\n", &id, name, &gpa)==3){
    sm *Nnode = (sm*)malloc(sizeof(sm));
    Nnode->id = id;
    strcpy(Nnode->name, name);
    Nnode->gpa = gpa;
    
    Nnode->prev = studentBack;
    Nnode->next = NULL;
    
    if(studentBack != NULL)
        studentBack->next = Nnode;
    
    else
        studentHead = Nnode;
    
        studentBack = Nnode;
}
    
    fclose(fp);
    }
  
  void deleteStudent(int id){
      sm *temp = studentHead;
      while(temp && temp->id !=id)
      temp=temp->next;
      
      if(temp == NULL){
          printf("Student Not Found\n");
          return;
      }   
      if(temp == studentHead)
      studentHead=temp->next;
      
      if(temp == studentBack)
      studentBack=temp->prev;
      
      if(temp->prev)
      temp->prev->next = temp->next;
      
      if(temp->next)
      temp->next->prev = temp->prev;
      
      free(temp);
      }
      
