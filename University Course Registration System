 void studentReport(){
   sm *temp=studentHead;
   
   int count=0;
   float totalgpa=0;
   float maxgpa=-1;
   char topper[30] = "";
   
   while(temp!=NULL){
       count++;
       totalgpa = totalgpa+temp->gpa;
   
   if(temp->gpa>maxgpa){
       maxgpa = temp->gpa;
       strcpy(topper, temp->name);
   }
   temp=temp->next;
 }
   printf("\n--- Student Report ---\n");

   if(count == 0){
        printf("No student data found!\n");
        return;
}

    printf("Total Students: %d\n",count);
    printf("Average Gpa: %f\n", totalgpa/count);
    printf("Topper: %s [GPA: %.2f]\n", topper, maxgpa);
}
void courseReport(){
    cm *temp = courseHead;

    int totalCourse = 0;
    int totalEnroll = 0;

    int maxEnroll = -1;
    char popularCourse[30];

    while(temp!=NULL){
        totalCourse++;
        totalEnroll = totalEnroll+temp->enroll;

    if(temp->enroll>maxEnroll){
        maxEnroll = temp->enroll;
        strcpy(popularCourse, temp->name);
    }
        temp=temp->next;
    }
    printf("\n--- Course Report ---\n");

    if(totalCourse == 0){
        printf("No course data found!\n");
        return;
    }

    printf("Total Courses: %d\n", totalCourse);
    printf("Total Enrollments: %d\n", totalEnroll);
    printf("Most Popular Course: %s (%d students)\n", popularCourse, maxEnroll);
}
 
