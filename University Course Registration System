   void regiCourse(){
       int sid, cid;
       printf("Enter Student ID: ");
       scanf("%d",&sid);
       getchar();
       printf("Enter Course ID: ");
       scanf("%d",&cid);
       getchar();
       sm *s = findstudent(sid);
       cm *c = courseHead;
       
       
       while(c && c->id != cid)
       c = c->next;
       
       if(!c || !s || c->enroll >= c->maxs){
           printf("Registration Failed\n");
           return;
       }
       rm *check = registrationHead;
       while(check){
           if(check -> STUDENTID == sid && check-> COURSEID == cid){
               printf("Already Registered!\n");
               return;
           }
           check = check->next;
       }
       rm *nn = (rm*)malloc(sizeof(rm));
       nn->STUDENTID = sid;
       nn->COURSEID = cid;
       nn->next = NULL;
       nn->prev = registrationBack;
       
       if(registrationBack){
          registrationBack->next = nn; 
       }else{
           registrationHead = nn;
       }
       registrationBack = nn;
       c->enroll++;
       printf("Rgistration Successful.\n");
   }
   
   void loadRegistration(){
    FILE *fp = fopen("Registration.text","r");
    if(fp == NULL){
        return;
    }

    int sid, cid;

    while(fscanf(fp, "%d, %d", &sid, &cid) == 2){
        rm *nn = (rm*)malloc(sizeof(rm));

        nn->STUDENTID = sid;
        nn->COURSEID = cid;

        nn->next = NULL;
        nn->prev = registrationBack;

        if(registrationBack != NULL){
            registrationBack->next = nn;
        } else {
            registrationHead = nn;
        }

        registrationBack = nn;
    }

    fclose(fp);
}
    
  void Dropregi(int sid, int cid){
      rm *temp = registrationHead;
      
      while(temp!=NULL){
          if(temp->STUDENTID == sid && temp->COURSEID == cid)
          break;
          temp=temp->next;
      }
            if(temp == NULL){
          printf("Registration Not Found\n");
          return;
            }
        if(temp == registrationHead)
        registrationHead = temp->next;
        
        if(temp == registrationBack)
        registrationBack = temp->prev;
        
        if(temp->next != NULL)
        temp->next->prev = temp->prev;
        
        if(temp->prev != NULL)
        temp->prev->next = temp->next;
        
        cm *t = courseHead;
        while(t && t->id != cid)
        t=t->next;
        
        if(t!=NULL && t->enroll>0)
        t->enroll--;
        
        free(temp);
          
      }
      
