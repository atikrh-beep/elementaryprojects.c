void loadData(){
    FILE *file;
    file = fopen("route_data.txt", "r");
    if (file == NULL){
        printf("\nNo saved data found.\n");
        return;
    }
    for (int i = 0; i < locationCount; i++){
        Edge *road = graph[i].roads;
        while (road != NULL){
            Edge *temp = road;
            road = road->next;
            free(temp);
        }
        graph[i].roads = NULL;
    }
    locationCount = 0;
    int savedLocations;
    fscanf(file, "%d",&savedLocations);
    if (savedLocations > MAX_LOCATIONS){
        printf("\nSaved data is too large!\n");
        fclose(file);
        return;
    }

    for (int i = 0; i < savedLocations; i++){
        fscanf(file," %[^\n]",graph[i].name);
        graph[i].roads = NULL;
    }
    locationCount = savedLocations;
    int roadCount;
    fscanf(file, "%d",&roadCount);
    for (int i = 0; i < roadCount; i++){
        int start;
        int destination;
        double distance;
        double time;
        double cost;
        int traffic;
        int weather;
        int blocked;

    fscanf(file,"%d %d %lf %lf %lf %d %d %d",&start,&destination,
    &distance,&time,&cost,&traffic,&weather,&blocked);
        Edge *road1 =(Edge*)malloc(sizeof(Edge));
        if (road1 == NULL)
            continue;

        road1->destination = destination;
        road1->distance = distance;
        road1->time = time;
        road1->cost = cost;
        road1->traffic = traffic;
        road1->weather = weather;
        road1->blocked = blocked;
        road1->next = graph[start].roads;
        graph[start].roads = road1;

        Edge *road2 = (Edge*)malloc(sizeof(Edge));
        if (road2 == NULL)
            continue;
        road2->destination = start;
        road2->distance = distance;
        road2->time = time;
        road2->cost = cost;
        road2->traffic = traffic;
        road2->weather = weather;
        road2->blocked = blocked;
        road2->next = graph[destination].roads;
        graph[destination].roads = road2;
    }
    fclose(file);
    printf("\nData loaded successfully!\n");
}

