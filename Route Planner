void fastestRoute(int start, int destination){
    double travelTime[MAX_LOCATIONS];
    int visited[MAX_LOCATIONS] = {0};
    int parent[MAX_LOCATIONS];
    for (int i = 0; i < locationCount; i++){
        travelTime[i] = INF;
        parent[i] = -1;
    }

    travelTime[start] = 0;
    for (int i = 0; i < locationCount; i++){
        int current = findMinimum(travelTime, visited);
        if (current == -1)
            break;
        visited[current] = 1;
        Edge *road = graph[current].roads;
        while (road != NULL){
            int next = road->destination;
            if (road->blocked == 0 && !visited[next]){
              double newTime = travelTime[current] + road->time;
                if (newTime < travelTime[next]){
                    travelTime[next] = newTime;
                    parent[next] = current;
                }
            }
            road = road->next;
        }
    }
    if (travelTime[destination] == INF){
        printf("\nNo route available!\n");
        return;
    }
    printf("\nFastest Route: ");
    printPath(parent, destination);
    printf("\nTime: %.2lf minutes\n", travelTime[destination]);
}

