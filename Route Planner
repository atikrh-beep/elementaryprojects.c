void trafficDijkstra(int start, int destination){
    double distance[MAX_LOCATIONS];
    int visited[MAX_LOCATIONS] = {0};
    int parent[MAX_LOCATIONS];
    int currentTraffic = getCurrentTrafficLevel();
    for (int i = 0; i < locationCount; i++){
        distance[i] = INF;
        parent[i] = -1;
    }
    distance[start] = 0;
    for (int i = 0; i < locationCount; i++){
        int current = findMinimum(distance, visited);
         if (current == -1)
            break;
        visited[current] = 1;

        Edge *road = graph[current].roads;
        while (road != NULL){
            int next = road->destination;
            if (road->blocked == 0 && !visited[next]){
                double adjustedTime = road->time;
                if (currentTraffic == 1){
                    adjustedTime = road->time;
                }else if (currentTraffic == 2){
                    adjustedTime = road->time * 1.5;
                }else{
                    adjustedTime = road->time * 2.0;
                }
        double newDistance = distance[current] + adjustedTime;
            if (newDistance < distance[next]){
                    distance[next] = newDistance;
                    parent[next] = current;
                }
            }
            road = road->next;
        }
    }
    if (distance[destination] == INF){
        printf("\nNo route available!\n");
        return;
    }

    printf("\n========================================\n");
    printf("       TIME-BASED TRAFFIC ROUTE\n");
    printf("========================================\n");

    printf("Traffic: ");
    if (currentTraffic == 1)
        printf("Low");
    else if (currentTraffic == 2)
        printf("Medium");
    else
        printf("High");
    printf("\n");
    printf("From: %s\n", graph[start].name);
    printf("To: %s\n", graph[destination].name);

    printf("Route: ");
    printPath(parent, destination);
    printf("\n");
    printf("Estimated Time: %.2lf minutes\n",distance[destination]);
    printf("========================================\n");
}

