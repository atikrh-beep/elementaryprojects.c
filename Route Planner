    reverseRoad->traffic = 1;
    reverseRoad->weather = 1;
    reverseRoad->blocked = 0;
    reverseRoad->next = graph[v].roads;
    graph[v].roads = reverseRoad;

   // printf("Road added successfully.\n");
}

void removeRoad(char from[], char to[]){
    int u = searchLocation(from);
    int v = searchLocation(to);
    if (u==-1 || v==-1){
        printf("Location not found!\n");
        return;
    }

    edge *current = graph[u].roads;
    edge *previous = NULL;
    while (current != NULL){
        if (current->destination == v){
            if (previous == NULL){
                graph[u].roads = current->next;
            }
            else{
                previous->next = current->next;
            }

            free(current);
            break;
        }

        previous = current;
        current = current->next;
    }

    current = graph[v].roads;
    previous = NULL;
    while (current != NULL){
        if (current->destination == u){
            if (previous == NULL){
                graph[v].roads = current->next;
            }
            else{
                previous->next = current->next;
            }

            free(current);
            break;
        }

        previous = current;
        current = current->next;
    }

    printf("Road removed successfully!\n");
}

