void networkStatistics(){
    int roadCount = 0;
    int openRoads = 0;
    int closedRoads = 0;
    int lowTraffic = 0;
    int mediumTraffic = 0;
    int highTraffic = 0;
    int clearWeather = 0;
    int rainyWeather = 0;
    int stormyWeather = 0;
    double totalDistance = 0;
    double totalTime = 0;
    double totalCost = 0;

    for (int i = 0; i < locationCount; i++){
        Edge *road = graph[i].roads;
        while (road != NULL){
            if (i < road->destination){
                roadCount++;
                totalDistance += road->distance;
                totalTime += road->time;
                totalCost += road->cost;
                if (road->blocked == 0)
                    openRoads++;
                else
                    closedRoads++;

                if (road->traffic == 1)
                    lowTraffic++;
                else if (road->traffic == 2)
                    mediumTraffic++;
                else
                    highTraffic++;

                if (road->weather == 1)
                    clearWeather++;
                else if (road->weather == 2)
                    rainyWeather++;
                else
                    stormyWeather++;
            }
            road = road->next;
        }
    }
    printf("\n========================================\n");
    printf("          NETWORK STATISTICS\n");
    printf("========================================\n");

    printf("Locations        : %d\n",locationCount);
    printf("Roads            : %d\n",roadCount);
    printf("Open Roads       : %d\n",openRoads);
    printf("Closed Roads     : %d\n",closedRoads);
    if (roadCount > 0){
printf("\nAverage Distance : %.2lf km\n",totalDistance / roadCount);
printf("Average Time     : %.2lf minutes\n",totalTime / roadCount);
printf("Average Cost     : %.2lf Tk\n",totalCost / roadCount);
    }
    printf("\nTraffic:\n");
    printf("Low              : %d\n",lowTraffic);
    printf("Medium           : %d\n",mediumTraffic);
    printf("High             : %d\n",highTraffic);
    printf("\nWeather:\n");
    printf("Clear            : %d\n",clearWeather);
    printf("Rainy            : %d\n",rainyWeather);
    printf("Stormy           : %d\n",stormyWeather);
}

