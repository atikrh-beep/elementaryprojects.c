void BFS(int start){
    int visited[MAX_LOCATIONS] = {0};
    int queue[MAX_LOCATIONS];
    int front = 0;
    int rear = 0;

    queue[rear] = start;
    rear++;

    visited[start] = 1;
    printf("\nBFS Traversal:\n");
    while (front < rear){
        int current = queue[front];
        front++;

        printf("%s", graph[current].name);

        edge *road = graph[current].roads;
        while (road != NULL){
            int next = road->destination;
       if (visited[next] == 0 && road->blocked == 0){
           visited[next] = 1;
           queue[rear] = next;
           rear++;
    }
    road = road->next;
        }
        if (front < rear){
            printf(" -> ");
        }
    }
    printf("\n");
}

