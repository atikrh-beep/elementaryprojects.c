int searchLocation(char name[]){
    for (int i = 0; i < locationCount; i++){
        if (strcmp(graph[i].name, name) == 0){
            return i;
        }
    }
    return -1;
}

void addLocation(){
    char name[NAME_SIZE];
    if (locationCount >= MAX_LOCATIONS){
        printf("\nMaximum number of locations reached!\n");
        return;
    }

    printf("Enter location name: ");
    scanf("%s", name);

    if (isDuplicateLocation(name)){
        printf("\nLocation already exists!\n");
        return;
    }
    strcpy(graph[locationCount].name, name);
    graph[locationCount].roads = NULL;
    locationCount++;
    printf("\nLocation added successfully!\n");
}

