    int parent[MAX_LOCATIONS];
    for (int i = 0; i < locationCount; i++){
        cost[i] = INF;
        parent[i] = -1;
    }
    cost[start] = 0;
    for (int i = 0; i < locationCount; i++){
        int current = findMinimum(cost, visited);
        if (current == -1)
            break;
        visited[current] = 1;
        Edge *road = graph[current].roads;
        while (road != NULL){
            int next = road->destination;
            if (road->blocked == 0 && !visited[next]){
                double newCost = cost[current] + road->cost;
                if (newCost < cost[next]){
                    cost[next] = newCost;
                    parent[next] = current;
                }
            }
            road = road->next;
        }
    }
    if (cost[destination] == INF){
        printf("\nNo route available!\n");
        return;
    }
    printf("\nCheapest Route: ");
    printPath(parent, destination);
    printf("\nCost: %.2lf Tk\n", cost[destination]);
}

