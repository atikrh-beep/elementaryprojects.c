void BFS(int start){
    int visited[MAX_LOCATIONS] = {0};
    int queue[MAX_LOCATIONS];
    int front = 0;
    int rear = 0;
    visited[start] = 1;
    queue[rear++] = start;
    printf("\nBFS Traversal:\n");
    while (front < rear){
        int current = queue[front++];
        printf("%s ",graph[current].name);

        Edge *road = graph[current].roads;
        while (road != NULL){
            int next = road->destination;
            if (!visited[next]){
                visited[next] = 1;
                queue[rear++] = next;
            }
            road = road->next;
        }
    }
    printf("\n");
}

void DFS(int current, int visited[]){
    visited[current] = 1;
    printf("%s ",graph[current].name);

    Edge *road = graph[current].roads;
    while (road != NULL){
        int next = road->destination;
        if (!visited[next]){
            DFS(next, visited);
        }
        road = road->next;
    }
}

int findMinimum(double distance[], int visited[]){
    double minimum = INF;
    int index = -1;
    for (int i = 0; i < locationCount; i++){
        if (!visited[i] && distance[i] < minimum){
            minimum = distance[i];
            index = i;
        }
    }
    return index;
}

void printPath(int parent[], int destination){
    if (destination == -1){
        return;
    }
    if (parent[destination] == -1){
        printf("%s",graph[destination].name);
        return;
    }
    printPath(parent, parent[destination]);
    printf(" -> %s", graph[destination].name);
}

void dijkstra(int start, int destination){
    double distance[MAX_LOCATIONS];
    int visited[MAX_LOCATIONS] = {0};
    int parent[MAX_LOCATIONS];
    for (int i = 0; i < locationCount; i++){
        distance[i] = INF;
        parent[i] = -1;
    }
    distance[start] = 0;
    for (int i = 0; i < locationCount; i++){
        int current = findMinimum(distance, visited);
        if (current == -1){
            break;
        }
        visited[current] = 1;

        Edge *road = graph[current].roads;
        while (road != NULL){
            int next = road->destination;
    if (road->blocked == 0 && !visited[next]){
    double newDistance = distance[current] + road->distance;
         if (newDistance < distance[next]){
                distance[next] = newDistance;
                parent[next] = current;
                }
            }
            road = road->next;
        }
    }
    if (distance[destination] == INF){
        printf("\nNo route available!\n");
        return;
    }


    printf("\n========== SHORTEST ROUTE ==========\n");

    printf("Route: ");

    printPath(parent, destination);

    printf("\n");
    printf("Distance: %.2lf km\n", distance[destination]);
}

void floydWarshall(){
    double distance[MAX_LOCATIONS]
                   [MAX_LOCATIONS];

    for (int i = 0; i < locationCount; i++){
        for (int j = 0; j < locationCount; j++){
            if (i == j){
                distance[i][j] = 0;
            }
            else{
                distance[i][j] = INF;
            }
        }
    }

    for (int i = 0; i < locationCount; i++){
        Edge *road = graph[i].roads;
        while (road != NULL){
        if (road->blocked == 0){
            distance[i][road->destination] = road->distance;
            }
            road = road->next;
        }
    }
for (int k = 0; k < locationCount; k++){
    for (int i = 0; i < locationCount; i++){
        for (int j = 0; j < locationCount; j++){
          if (distance[i][k] != INF && distance[k][j] != INF){
            double newDistance = distance[i][k] + distance[k][j];
              if (newDistance < distance[i][j]){
                distance[i][j] = newDistance;
                    }
                }
            }
        }
    }

    printf("\n========== FLOYD-WARSHALL ==========\n");
    for (int i = 0; i < locationCount; i++){
        for (int j = 0; j < locationCount; j++){
            if (distance[i][j] == INF){
                printf("INF\t");
            }else{
                printf("%.1lf\t", distance[i][j]);
            }
        }
        printf("\n");
    }
}

int isValidLocationName(char name[]){
    if (strlen(name) == 0)
        return 0;

    if (strlen(name) >= NAME_SIZE)
        return 0;

    return 1;
}
int isValidPositiveNumber(double value){
    if (value <= 0)
        return 0;
    return 1;
}
int isValidLocationIndex(int index){
    if (index < 0 || index >= locationCount)
        return 0;
    return 1;
}
int isDuplicateLocation(char name[]){
    for (int i = 0; i < locationCount; i++){
        if (strcmp(graph[i].name, name) == 0)
            return 1;
    }
    return 0;
}
int isRoadExists(int from, int to){
    if (!isValidLocationIndex(from) || !isValidLocationIndex(to)){
        return 0;
    }
    Edge *road = graph[from].roads;
    while (road != NULL){
        if (road->destination == to)
            return 1;
        road = road->next;
    }
    return 0;
}int isValidTrafficLevel(int traffic){
    if (traffic < 1 || traffic > 3)
        return 0;
    return 1;
}int isValidWeatherCondition(int weather){
    if (weather < 1 || weather > 3)
        return 0;
    return 1;
